# Repo-wide analyzer and editor configuration.
#
# This file lives at the repository root so that a rule meant for the whole repo
# has somewhere to go (issue #638). Rules that are deliberately scoped to one
# project stay scoped, via a path-qualified section below.
root = true

# IDE0161 (file-scoped namespaces) applies to every C# file in the repo.
#
# EnforceCodeStyleInBuild in Directory.Build.props is what makes this rule - and
# the IDE* family generally - run during `dotnet build` rather than only inside
# an editor. Together with the repo-wide TreatWarningsAsErrors that turns a
# violation into a failed build, which is the point: a style checked only by
# whoever happens to open the file in an IDE is not enforced at all (issue #484).
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# CA2007 (ConfigureAwait) applies to the Daqifi.Core library only; test projects
# are exempt (CONTRIBUTING.md), hence the path-qualified section. The library's
# sync facades (DaqifiDevice.Connect(), DaqifiDeviceFactory.ConnectTcp, ...) block
# on its own async work, so one naked await deadlocks a caller on a WPF/WinForms
# UI thread, with no timeout and no exception (issue #495). That is why it covers
# every await in the library, not just the connect path.
[src/Daqifi.Core/**.cs]
dotnet_diagnostic.CA2007.severity = warning

# CA1707 (no underscores in public names) is scoped here too: only Daqifi.Core
# publishes a public surface, and test methods are named Method_Case_Expectation.
# Left at the default `public` api_surface on purpose: `all` would also flag
# private static readonly `_camelCase` fields such as
# SdCardFileParserFactory._supportedExtensions, fighting the repo's own naming
# convention for names no consumer can see.
dotnet_diagnostic.CA1707.severity = warning

# RS0041 (nullable-oblivious public API) is silenced on this one file only.
# protoc emits it with no `#nullable enable`, and hand annotations would be lost
# the next time it is regenerated. Its oblivious members stay recorded with the
# `~` prefix in PublicAPI.Shipped.txt, and hand-written public API keeps RS0041.
[src/Daqifi.Core/Communication/Messages/DaqifiOutMessage.cs]
dotnet_diagnostic.RS0041.severity = none
