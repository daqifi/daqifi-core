<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ImplicitUsings, Nullable and TreatWarningsAsErrors come from the repo-root
         Directory.Build.props. Nothing centralized may be restated here; see
         Daqifi.Core.Tests/Build/DirectoryBuildPropsTests.cs. -->

    <!-- net10.0 only, so `dotnet run -c Release` needs no -f. For net9.0 numbers add
         [SimpleJob(RuntimeMoniker.Net90)] to a class, not a second TFM; see the README. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <!-- Measuring instrument, not a shipped package. Also keeps the repo-root
         Directory.Build.targets package metadata, which is gated on IsPackable, off it. -->
    <IsPackable>false</IsPackable>

    <!-- Explicitly not a test project, so `dotnet test` on the solution skips this exe. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="..\Daqifi.Core\Daqifi.Core.csproj" />
  </ItemGroup>

</Project>
