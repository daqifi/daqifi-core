<Project>

  <!--
    Repo-wide build properties. MSBuild imports this file into every project
    under the repository root, so a setting here is declared once instead of
    being copy-pasted into each .csproj (issue #638).

    Only settings that every project in the repo should share belong here.
    Anything a project legitimately decides for itself - PackageId, OutputType,
    PackAsTool, IsPackable, coverlet output, per-package metadata - stays in
    that project's .csproj. Package metadata shared by the two published
    packages lives in the repo-root Directory.Build.targets (issue #644), which
    is imported late enough to see $(IsPackable) and skip the test projects.

    Do not set TargetFramework here. Which frameworks a project builds for
    belongs in that project's .csproj; a default here would silently apply to
    any project added later. The uniformity that matters is guarded by a test
    instead: Daqifi.Mcp must ship an asset for every framework Daqifi.Core
    supports. See Daqifi.Core.Tests/Build/TargetFrameworkTests.cs.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Run the IDE* code-style analyzers as part of the build, not just inside an
      editor (issue #484). Without this the severities declared in .editorconfig
      are advisory: a violation shows as a squiggle to whoever opens the file and
      as nothing at all in CI. With it, and with TreatWarningsAsErrors above, a
      violation fails the build for everyone.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
